		        // =====================================================
		        // SEARCH WEATHER
		        // =====================================================

		        void searchWeather() {

		            String city =
		                    cityField.getText().trim();

		            String dateText =
		                    dateField.getText().trim();


		            if (city.isEmpty()
		                    || dateText.isEmpty()) {

		                JOptionPane.showMessageDialog(
		                        this,
		                        "Please enter City and Date.",
		                        "Input Error",
		                        JOptionPane.ERROR_MESSAGE
		                );

		                return;
		            }


		            LocalDate date;

		            try {

		                date =
		                        LocalDate.parse(
		                                dateText,
		                                inputFormat
		                        );

		            } catch (Exception ex) {

		                JOptionPane.showMessageDialog(
		                        this,
		                        "Date format must be DD-MM-YYYY",
		                        "Invalid Date",
		                        JOptionPane.ERROR_MESSAGE
		                );

		                return;
		            }


		            searchButton.setEnabled(false);

		            locationLabel.setText(
		                    "Searching..."
		            );

		            conditionLabel.setText(
		                    ""
		            );

		            temperatureLabel.setText(
		                    ""
		            );

		            detailsLabel.setText(
		                    ""
		            );


		            SwingWorker<WeatherData, Void> worker =
		                    new SwingWorker<>() {

		                @Override
		                protected WeatherData doInBackground()
		                        throws Exception {

		                    return getWeather(
		                            city,
		                            date
		                    );
		                }


		                @Override
		                protected void done() {

		                    searchButton.setEnabled(
		                            true
		                    );

		                    try {

		                        WeatherData data =
		                                get();

		                        showWeather(data);

		                    } catch (Exception ex) {

		                        JOptionPane.showMessageDialog(
		                                WeatherWindow.this,
		                                "Unable to get weather.\n\n"
		                                + ex.getMessage(),
		                                "Weather Error",
		                                JOptionPane.ERROR_MESSAGE
		                        );

		                        locationLabel.setText(
		                                "Weather search failed"
		                        );
		                    }
		                }
		            };


		            worker.execute();
		        }


		        // =====================================================
		        // GET WEATHER FROM API
		        // =====================================================

		        WeatherData getWeather(
		                String city,
		                LocalDate date
		        ) throws Exception {


		            String encodedCity =
		                    URLEncoder.encode(
		                            city,
		                            StandardCharsets.UTF_8
		                    );


		            // -------------------------------------------------
		            // STEP 1: CITY → LATITUDE / LONGITUDE
		            // -------------------------------------------------

		            String geoUrl =
		                    "https://geocoding-api.open-meteo.com/v1/search"
		                    + "?name="
		                    + encodedCity
		                    + "&count=1"
		                    + "&language=en"
		                    + "&format=json";


		            String geoJson =
		                    httpGet(geoUrl);


		            if (!geoJson.contains("\"results\"")) {

		                throw new Exception(
		                        "City not found."
		                );
		            }


		            double latitude =
		                    getDouble(
		                            geoJson,
		                            "\"latitude\":"
		                    );


		            double longitude =
		                    getDouble(
		                            geoJson,
		                            "\"longitude\":"
		                    );


		            String foundName =
		                    getString(
		                            geoJson,
		                            "\"name\":\""
		                    );


		            String country =
		                    getString(
		                            geoJson,
		                            "\"country\":\""
		                    );


		            // -------------------------------------------------
		            // STEP 2: WEATHER DATA
		            // -------------------------------------------------

		            String apiDate =
		                    date.format(apiFormat);


		            String weatherUrl =
		                    "https://api.open-meteo.com/v1/forecast"
		                    + "?latitude="
		                    + latitude
		                    + "&longitude="
		                    + longitude
		                    + "&daily="
		                    + "weather_code,"
		                    + "temperature_2m_max,"
		                    + "temperature_2m_min,"
		                    + "precipitation_sum,"
		                    + "wind_speed_10m_max"
		                    + "&timezone=auto"
		                    + "&start_date="
		                    + apiDate
		                    + "&end_date="
		                    + apiDate;


		            String weatherJson =
		                    httpGet(weatherUrl);


		            // -------------------------------------------------
		            // READ FIRST DAILY VALUE
		            // -------------------------------------------------

		            int weatherCode =
		                    (int) getFirstArrayNumber(
		                            weatherJson,
		                            "\"weather_code\":["
		                    );


		            double maxTemp =
		                    getFirstArrayNumber(
		                            weatherJson,
		                            "\"temperature_2m_max\":["
		                    );


		            double minTemp =
		                    getFirstArrayNumber(
		                            weatherJson,
		                            "\"temperature_2m_min\":["
		                    );


		            double precipitation =
		                    getFirstArrayNumber(
		                            weatherJson,
		                            "\"precipitation_sum\":["
		                    );


		            double wind =
		                    getFirstArrayNumber(
		                            weatherJson,
		                            "\"wind_speed_10m_max\":["
		                    );


		            WeatherData data =
		                    new WeatherData();


		            data.city = foundName;
		            data.country = country;
		            data.date = date;

		            data.weatherCode =
		                    weatherCode;

		            data.maxTemp =
		                    maxTemp;

		            data.minTemp =
		                    minTemp;

		            data.precipitation =
		                    precipitation;

		            data.wind =
		                    wind;


		            return data;
		        }


